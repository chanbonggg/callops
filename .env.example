# Documentation only; CallOps never auto-loads this file.
# Use a data directory outside the repository, e.g. C:/callops-runtime or /srv/callops.
CALLOPS_DATA_ROOT=/srv/callops
CALLOPS_DATABASE_URL=postgresql://callops_app:REPLACE_ME@127.0.0.1:5432/callops?sslmode=disable
# Only the migration process receives this setting. Do not give it to the app.
CALLOPS_MIGRATION_DATABASE_URL=postgresql://callops_migrator:REPLACE_ME@127.0.0.1:5432/callops?sslmode=disable
# Web process only. Place real values in explicit process environment, never Git.
CALLOPS_OWNER=REPLACE_ME
CALLOPS_PASSWORD_HASH=REPLACE_WITH_WERKZEUG_SCRYPT_HASH
CALLOPS_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CALLOPS_WORKER_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# RAG stays disabled until the designated worker supports RAG_EMBED and RAG_ANSWER.
CALLOPS_ENABLE_RAG=0
CALLOPS_REAL_WORKER_ID=
